# Секреты — никогда в git (§8.2: только .env, chmod 600)
.env
.env.*
!.env.example
# Шаблон .env инстанса — НЕ секрет, а часть выдачи: без него deploy.sh у ученика
# падает на sed уже после провизии. Под `.env.*` он попадал молча — поэтому исключение.
!deploy/templates/.env.template

# Отчёты деплоя (§7.4) — содержат имена инстансов/путей владельца, в репо не едут.
# Сам каталог держится в git через deploys/.gitkeep.
deploys/*
!deploys/.gitkeep

# Окружение и сборка
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Состояние инстанса — живёт в ~/agents/<name>/state/, не в репо (§4)
*.db
*.db-wal
*.db-shm

# Кэши инструментов
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Артефакты цикла разработки
.forge/

# Сырой лог прогона канареек — факты человек оформляет в docs/canaries/<дата>-results.md
docs/canaries/last-run.log
