# Секреты — никогда в git (§8.2: только .env, chmod 600)
.env
.env.*
!.env.example
# ШАБЛОН .env (секретов не содержит — плейсхолдеры) обязан быть в репо: его рендерит
# deploy.sh, и без него свежий клон у ученика падает на первом же деплое. Правило
# `.env.*` выше молча его съедало — исключение здесь.
!deploy/templates/.env.template

# Ответы install.sh (без секретов, chmod 600) — состояние машины, не код
.install.conf
# Точка откатa update.sh — состояние конкретного сервера
.update-prev

# Окружение и сборка
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Состояние инстанса — живёт в ~/agents/<name>/state/, не в репо (§4)
*.db
*.db-wal
*.db-shm

# Кэши инструментов
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Артефакты цикла разработки
.forge/

# Сырой лог прогона канареек — факты человек оформляет в docs/canaries/<дата>-results.md
docs/canaries/last-run.log
