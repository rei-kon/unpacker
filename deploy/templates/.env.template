# .env инстанса движка «Распаковщик» (рендерится deploy.sh, chmod 600, в .gitignore).
# Значения из окружения читает engine/core/config.py (pydantic Settings).
# CSV целых (НЕ JSON) — config.py разбирает список через запятую. Первый = владелец (health-алерты).
ALLOWED_USER_IDS={{USERS}}
# Пути состояния — относительно cwd бота (= инстанс-каталог, systemd WorkingDirectory).
DB_PATH=state/state.db
HEALTH_PATH=state/health.json
# Дефолтный проект окна при первом сообщении (сид завёл строку project с этим slug).
DEFAULT_PROJECT_SLUG={{PROJECT_SLUG}}
# Тюнинг (опц):
# RESPONSE_TIMEOUT=180
# IDLE_TIMEOUT=1800
# --- секреты дописываются deploy.sh через printf (не через sed — не светятся в argv/ps/set -x): ---
# TELEGRAM_BOT_TOKEN=...
# CLAUDE_CODE_OAUTH_TOKEN=...   (при --cc-token, контур subscription)
# ANTHROPIC_API_KEY=...         (при --api-key, контур api)
