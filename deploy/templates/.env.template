# .env инстанса движка «Распаковщик» (рендерится deploy.sh, chmod 600, в .gitignore).
# Значения из окружения читает engine/core/config.py (pydantic Settings). Незнакомые ключи
# ядро игнорирует, так что закомментированные строки ниже — безопасная карта настроек:
# раскомментируй нужную и рестартни бота (sudo systemctl restart agent-tg@<имя>).
#
# ВСЕ пути здесь — относительно cwd бота, то есть инстанс-каталога (systemd WorkingDirectory).

# ── кто может писать боту ────────────────────────────────────────────────────
# CSV целых (НЕ JSON) — config.py разбирает список через запятую. Первый = владелец (health-алерты).
# Меняется передеплоем: deploy.sh --users <id,id> применяет новое значение к готовому .env.
ALLOWED_USER_IDS={{USERS}}

# ── состояние инстанса (§4: живёт здесь, НЕ в папке-мозге) ───────────────────
# Каталог состояния: от него считаются загрузки и второй корень песочницы отдачи файлов.
STATE_DIR=state
DB_PATH=state/state.db
HEALTH_PATH=state/health.json

# ── проект по умолчанию ──────────────────────────────────────────────────────
# Дефолтный проект окна при первом сообщении (сид завёл строку project с этим slug).
DEFAULT_PROJECT_SLUG={{PROJECT_SLUG}}

# ── косметика и файлы (§6.1/§9): всё включено, выключается флагом ────────────
# Кнопки-триггеры: рабочая копия живёт в инстансе, синк мозга её НЕ перезатирает.
# BUTTONS_ENABLED=true
# BUTTONS_PATH=buttons.yaml
# Приём файлов от пользователя (кладутся в каталог загрузок инстанса).
# UPLOADS_ENABLED=true
# UPLOADS_DIR=state/uploads
# Потолок на приём файла в байтах. Выше 20971520 (20 МБ) поднять нельзя — это предел Bot API,
# Telegram всё равно не отдаст боту файл больше, и обещание было бы ложным.
# MAX_UPLOAD_BYTES=20971520
# Отдача файлов ботом (маркер [SEND_FILE:путь] в ответе агента).
# SEND_FILE_ENABLED=true
# Черновик «печатает…»: ответ виден по мере генерации, финал — последняя правка того же
# сообщения. Выключить целиком — STREAM_ENABLED=false (бот ответит одним сообщением в конце).
# STREAM_ENABLED=true
# Как часто править черновик в первые секунды, сек. Дальше движок сам замедляется (×2 и ×4):
# у Telegram потолок около 20 правок в минуту на чат, и он общий с реакциями и доставкой.
# Ставь больше, если бот живёт в людной группе. Ниже 0.2 движок не пустит: это уже не
# «быстро», а цикл без сна, который жжёт процессор впустую.
# STREAM_INTERVAL=1.2
# Сколько символов черновика показывать. Больше — видно свежий хвост, остальное скрыто «…»;
# на целый ответ это не влияет, финал приходит полностью. Допустимо 200–4000: шире окна
# Telegram отвергает каждое сообщение, уже — в окне не остаётся места под сам текст.
# STREAM_MAX_UNITS=3600

# ── тайминги ────────────────────────────────────────────────────────────────
# RESPONSE_TIMEOUT=180
# IDLE_TIMEOUT=1800

# ── поведение агента (обычно не нужно: личность берётся из CLAUDE.md мозга) ───
# Рамка поверх личности мозга — короткая приписка к системному промпту, НЕ копия CLAUDE.md.
# SYSTEM_PROMPT_APPEND=
# Полная замена системного промпта. Осторожно: выключает пресет Claude Code целиком.
# SYSTEM_PROMPT=
# Потолок шагов на один ответ. Пусто = без ограничения (упёрлись — агент честно скажет).
# MAX_TURNS=

# ── контур инстанса (§8.1) — пишет deploy.sh, руками не меняй ────────────────
# AUDIENCE=internal|client   — с кем говорит бот. Клиентский контур целиком = Фаза 4;
#   поменять значение здесь НЕ равно «получить клиентского бота»: гейты живут в deploy.sh.
# AUTH_MODE=subscription|api — на чём бежит движок. Один инстанс — один контур: смешение
#   (api-ключ + oauth-токен) deploy.sh отклоняет, и передеплой контур не меняет.
#
# ДЕКЛАРАЦИЯ, А НЕ НАСТРОЙКА: лимиты API-контура ядро НЕ читает до Фазы 4 (LimitsPolicy) —
# deploy.sh пишет их в .env, чтобы значение было видно глазами и в отчёте, но потолок
# сейчас держит только биллинг Anthropic. Выставить их здесь и считать, что расход
# ограничен, — самообман:
# LIMIT_REQUESTS_PER_DAY=...
# LIMIT_TOKENS_PER_DAY=...

# --- секреты дописываются deploy.sh через printf (не через sed — не светятся в argv/ps/set -x): ---
# TELEGRAM_BOT_TOKEN=...
# CLAUDE_CODE_OAUTH_TOKEN=...   (при --cc-token / --cc-token-file, контур subscription)
# ANTHROPIC_API_KEY=...         (при --api-key, контур api)
